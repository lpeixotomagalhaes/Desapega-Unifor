# Copie este arquivo para .env e preencha os valores.
# As connection strings exatas estao no dashboard do Supabase:
# https://supabase.com/dashboard/project/txztxdcunjwfnkxoxamh -> botao "Connect"

# Transaction pooler (porta 6543) - OBRIGATÓRIA na API em runtime (local e Render).
# NÃO use db.*.supabase.co aqui no Render: esse host costuma ser só IPv6 e a API fica com 500.
# Dashboard Supabase → Connect → "Transaction pooler" (modo Transaction).
DATABASE_URL="postgresql://postgres.txztxdcunjwfnkxoxamh:[SUA-SENHA]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexão para o Prisma CLI (migrate / db push). Preferir Session pooler (5432) ou Direct.
DIRECT_URL="postgresql://postgres.txztxdcunjwfnkxoxamh:[SUA-SENHA]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Segredo usado para assinar os tokens JWT (use um valor longo e aleatorio)
JWT_SECRET="troque-por-um-segredo-forte"

# Origens permitidas no CORS (produção). Separe por vírgula se tiver mais de uma.
# Ex.: https://desapega-web.onrender.com
CORS_ORIGIN=""

# Client ID OAuth do Google (Google Cloud Console > APIs & Services > Credentials
# > Create Credentials > OAuth client ID > Web application). So o Client ID e
# necessario aqui (o login usa verificacao de ID token, sem client secret).
# Precisa ser o MESMO valor usado em frontend/.env.local (NEXT_PUBLIC_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=""

# E-mail do primeiro SUPER_ADMIN (promovido/criado no `npm run seed`).
SUPER_ADMIN_EMAIL="admin@edu.unifor.br"
SUPER_ADMIN_PASSWORD="admin123456"

# Use 3002 locally if `prisma dev` is running (Streams binds 127.0.0.1:3001).
PORT=3002
