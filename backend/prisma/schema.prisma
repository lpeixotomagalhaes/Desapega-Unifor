generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // O NestJS compila para CommonJS, então o client precisa seguir o mesmo formato
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  // URLs configuradas em prisma.config.ts (DATABASE_URL / DIRECT_URL)
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id                    String         @id @default(cuid())
  name                  String
  email                 String         @unique
  passwordHash          String?
  googleId              String?        @unique
  avatarUrl             String?
  phone                 String?
  bio                   String?
  course                String?
  enrollment            String?
  role                  UserRole       @default(USER)
  accountStatus         AccountStatus  @default(ACTIVE)
  suspendedUntil        DateTime?
  moderationReason      String?
  moderatedAt           DateTime?
  moderatedBy           User?          @relation("UserModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedById         String?
  moderatedUsers        User[]         @relation("UserModerator")
  onboardingCompletedAt DateTime?
  lastSeenAt            DateTime?
  items                 Item[]         @relation("ItemOwner")
  negotiations          Item[]         @relation("ItemNegotiation")
  interests             ItemInterest[]
  notifications         Notification[]
  supportTickets        SupportTicket[] @relation("TicketAuthor")
  assignedTickets       SupportTicket[] @relation("TicketAssignee")
  reviewsGiven          Review[]       @relation("ReviewRater")
  reviewsReceived       Review[]       @relation("ReviewRated")
  savedItems            SavedItem[]
  itemComments          ItemComment[]
  auditLogs             AuditLog[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([googleId])
  @@index([role])
  @@index([lastSeenAt])
  @@index([accountStatus])
  @@index([course])
}

enum Category {
  LIVROS
  ELETRONICOS
  ENGENHARIA
  COMPUTACAO
  VESTUARIO
  MOVEIS
  OUTROS
}

enum ItemStatus {
  ATIVO
  NEGOCIANDO
  CONCLUIDO
}

model Item {
  id                String     @id @default(cuid())
  title             String
  description       String
  categories        Category[]
  price             Decimal?   @db.Decimal(10, 2)
  isDonation        Boolean    @default(false)
  imageUrl          String
  imageUrls         String[]   @default([])
  status            ItemStatus @default(ATIVO)
  user              User       @relation("ItemOwner", fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  negotiatingWith   User?      @relation("ItemNegotiation", fields: [negotiatingWithId], references: [id], onDelete: SetNull)
  negotiatingWithId String?
  interests         ItemInterest[]
  savedBy           SavedItem[]
  comments          ItemComment[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([userId])
  @@index([status])
  @@index([negotiatingWithId])
}

model ItemComment {
  id        String   @id @default(cuid())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([userId])
}

model SavedItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}

enum OrderStatus {
  PENDENTE
  NEGOCIANDO
  ENTREGUE
}

model ItemInterest {
  id                String      @id @default(cuid())
  item              Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId            String
  buyer             User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId           String
  course            String      @default("")
  enrollment        String      @default("")
  acceptListedPrice Boolean     @default(true)
  offeredPrice      Decimal?    @db.Decimal(10, 2)
  meetupDay         String      @default("")
  meetupTime        String      @default("")
  campusBlock       String      @default("")
  status            OrderStatus @default(PENDENTE)
  review            Review?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([itemId, buyerId])
  @@index([itemId])
  @@index([buyerId])
  @@index([status])
}

model Review {
  id          String       @id @default(cuid())
  order       ItemInterest @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String       @unique
  rater       User         @relation("ReviewRater", fields: [raterId], references: [id], onDelete: Cascade)
  raterId     String
  ratedUser   User         @relation("ReviewRated", fields: [ratedUserId], references: [id], onDelete: Cascade)
  ratedUserId String
  rating      Int
  comment     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([ratedUserId])
  @@index([raterId])
}

enum NotificationType {
  WELCOME
  ITEM_PUBLISHED
  NEW_INTEREST
  PROPOSAL_ACCEPTED
  ITEM_STATUS_CHANGED
  ITEM_SAVED_UPDATE
  ORDER_DELIVERED
  REVIEW_REQUEST
  NEW_REVIEW
  SUPPORT_REPLY
  ACCOUNT_MODERATION
}

model Notification {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  title     String
  body      String
  itemId    String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([userId, readAt])
}

model SupportTicket {
  id              String              @id @default(cuid())
  user            User                @relation("TicketAuthor", fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  subject         String
  message         String
  status          SupportTicketStatus @default(OPEN)
  adminReply      String?
  assignedAdmin   User?               @relation("TicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  assignedAdminId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@index([assignedAdminId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
}
