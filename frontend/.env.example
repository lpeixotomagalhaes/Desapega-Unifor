# Copie para .env.local
# Local:
NEXT_PUBLIC_API_URL=http://localhost:3001
# Produção (Render), ex.:
# NEXT_PUBLIC_API_URL=https://desapega-api.onrender.com

# Client ID OAuth do Google (mesmo valor do GOOGLE_CLIENT_ID no backend/.env).
# Sem isso, o botão "Continuar com o Google" simplesmente não é renderizado.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
