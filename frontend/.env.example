# Copie para .env.local
# Local:
NEXT_PUBLIC_API_URL=http://localhost:3002
# Produção (API no Render), ex.:
# NEXT_PUBLIC_API_URL=https://desapega-unifor-nvt5.onrender.com

# Client ID OAuth do Google (mesmo valor do GOOGLE_CLIENT_ID no backend/.env).
# No Google Cloud Console → Credenciais → OAuth 2.0:
# - Origens JS: http://localhost:3000 (e o domínio de produção)
# - URI de redirecionamento: http://localhost:3000/auth/google/callback
#   (e o equivalente em produção)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
